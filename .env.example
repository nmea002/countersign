# Countersign runs with none of these set: every integration has a built-in stand-in.
# Add a key and restart to switch that integration to the real service.
PORT=3000
# Loopback by default: reach the server through SSH port forwarding. Any other HOST
# (e.g. 0.0.0.0 for direct LAN access) refuses to start unless COUNTERSIGN_TOKEN is set.
HOST=127.0.0.1
# Shared secret for the dashboard and API: open /login?token=... once, or send
# "Authorization: Bearer ...". Generate a long random value; never commit it.
COUNTERSIGN_TOKEN=
# Set to 0 to disable POST /api/seed (reset) on a shared or live server.
ALLOW_RESET=1
COMPANY_NAME=Tidewater Brewing Co.
APPROVER_NAME=Dana (Controller)

# Gemini: reads the invoice email and writes the verdict explanation
GEMINI_API_KEY=
# Verified for this project's account on November 14, 2026; recheck availability if needed.
GEMINI_MODEL=gemini-3.5-flash-lite

# MongoDB Atlas: vendors, payment requests, case files, messages, ledger
MONGODB_URI=
MONGODB_DB=countersign
# Optional Atlas Search index on vendors.name for look-alike vendor search
ATLAS_SEARCH_INDEX=vendors_name

# Tiger Data (TimescaleDB): payments hypertable and vendor_daily continuous aggregate
TIGER_DATABASE_URL=
# The private Windows transfer copy uses sslmode=verify-full and
# sslrootcert=certs/tiger-ca.crt. Run from the repo root; never disable TLS verification.

# Capital One Nessie v2: operating account, vendor payee accounts, bills and transfers
# Key from https://v2.nessieisreal.com/account
NESSIE_API_KEY=
NESSIE_URL=https://v2-prod-api.nessieisreal.com
# Public https address of this server once deployed. Registers Nessie's decision hook.
PUBLIC_URL=

# Solana devnet: an existing funded key is available in the private transfer copy.
# Do not run scripts/solana-setup.js for migration: it creates and prints a new secret.
SOLANA_SECRET_KEY=
SOLANA_RPC_URL=https://api.devnet.solana.com

# Photon 2.0: texts the approver. All four are needed.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_PLATFORM=imessage
# The approver's own phone (E.164). Only this number can approve or hold.
PHOTON_APPROVER_HANDLE=
# Optional: the assigned v2 agent number; use the private inventory, not the legacy Spectrum line.
PHOTON_AGENT_HANDLE=

# Background worker: minutes before an unanswered hold gets one reminder text
REMIND_AFTER_MIN=30
# Photon first start: how far back to read the inbox to find the approver's thread.
# Messages older than the first start only open the thread; they never approve or hold.
PHOTON_BACKFILL_HOURS=72
